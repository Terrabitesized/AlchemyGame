      type: {class: StickyNoteModel, ns: Unity.Behavior.GraphFramework, asm: Unity.Behavior.GraphFramework}
      data:
        Position: {x: -372.23254, y: 59.26754}
        ID:
          m_Value0: 8740306803522823991
          m_Value1: 11649287898953131828
        Parents: []
        PortModels: []
        Text: 'If you wish to have a Start Of Combat Ability, assign it

          here.
          Otherwise, ensure that the "Start of Combat

          Ability" is set
          to "EmptyEnemyAbility", as there is no

          easy way to check for
          "null" instead.


          If a Start of Combat Ability is present, it
          will run, then

          proceed to the main loop. Otherwise, the graph
          will wait

          "Start of Combat Delay" seconds before entering the

          main
          loop.'
