    - rid: 7865913068295553297
      type: {class: StickyNoteModel, ns: Unity.Behavior.GraphFramework, asm: Unity.Behavior.GraphFramework}
      data:
        Position: {x: -1534.4565, y: 357.6842}
        ID:
          m_Value0: 12910964681504986016
          m_Value1: 8556667661697189404
        Parents: []
        PortModels: []
        Text: 'A node that allows an EnemyAbility

          to only be used a specified
          number

          of times. If the graph reaches this node,

          and
          the ability has already been used

          the Max # of times, the node
          will return

          a Status.Failure.'
    - rid: 7865913068295553334
      type: {class: StickyNoteModel, ns: Unity.Behavior.GraphFramework, asm: Unity.Behavior.GraphFramework}
      data:
        Position: {x: -1850.9702, y: 317.07224}
        ID:
          m_Value0: 452705632963214574
          m_Value1: 11120611774719862015
        Parents: []
        PortModels: []
        Text: 'The most important node in this system.

          Sends the attached
          EnemyAbility as a

          parameter to the EnemyAbilityExecuter.cs

          on
          the same gameObject as this Behavior

          graph. This node will not
          proceed to the

          next in the graph until the ability has

          completed.
          (Which is currently defined as

          enemyAttackPattern.WarningDuration
          +

          enemyAttackPattern.AttackDuration;)'
    - rid: 7865913068295553371
      type: {class: ActionNodeModel, ns: Unity.Behavior, asm: Unity.Behavior.Authoring}
      data:
        Position: {x: -1842.3003, y: 674.43024}
        ID:
          m_Value0: 161232740501105624
