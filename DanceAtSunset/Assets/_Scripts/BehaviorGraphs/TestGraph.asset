    - rid: 7865913068295553563
      type: {class: StickyNoteModel, ns: Unity.Behavior.GraphFramework, asm: Unity.Behavior.GraphFramework}
      data:
        Position: {x: -2139.438, y: 855.93256}
        ID:
          m_Value0: 6605801603211175926
          m_Value1: 4363110467843630119
        Parents: []
        PortModels: []
        Text: 'A node connected to CombatCanvas.SetPopup().

          Fades a popup
          on screen with specified text and

          duration when this node is
          reached, and will replace

          any other active popups generated
          with

          CombatCanvas.SetPopup(). (Note: this node will

          immediately
          return a Status.Success, and graph flow

          will continue immediately
          after this node is reached)'
    - rid: 7865913068295553744
      type: {class: StickyNoteModel, ns: Unity.Behavior.GraphFramework, asm: Unity.Behavior.GraphFramework}
      data:
        Position: {x: 300.77106, y: 344.57535}
        ID:
          m_Value0: 8032404654532283277
          m_Value1: 6875604549737337589
        Parents: []
        PortModels: []
        Text: 'A crutial node to the graph. When the graph flows through to the end,

          it
          will return here and attempt to repeat any logic contained below.

          This
          is what allows the enemy to endlessly attack.'
    - rid: 7865913068295553817
      type: {class: CompositeNodeModel, ns: Unity.Behavior, asm: Unity.Behavior.Authoring}
